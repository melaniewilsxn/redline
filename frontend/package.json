{
  "name": "redline-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "eslint . && tsc -b --pretty false && prettier --check .",
    "format": "prettier --write .",
    "generate:api-types": "openapi-typescript ${REDLINE_API_URL:-http://localhost:8000}/openapi.json -o src/api/schema.ts"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "diff": "9.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
